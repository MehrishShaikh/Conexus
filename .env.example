# Copy to .env (never commit real secrets — anything VITE_* is visible in the browser bundle).

# Public URL of the deployed prototype. Shown on the Phase 3 page. Leave empty until deployed.
VITE_DEPLOY_URL=

# OPTIONAL: URL of YOUR OWN server-side proxy that answers doubts with an LLM.
# See docs/AI_PROXY.md for the request/response contract. Never put an API key here.
VITE_AI_ENDPOINT=

# OPTIONAL: URL of your own translation proxy (same contract style). Empty = browser Translator API or demo mode.
VITE_TRANSLATE_ENDPOINT=
